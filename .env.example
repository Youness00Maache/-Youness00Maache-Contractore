# ContractorDocs frontend environment (Vite). Copy to .env.local for local dev; set the same
# variables in Vercel -> Project -> Settings -> Environment Variables for production.
# Everything here is PUBLIC (shipped in the JS bundle). Never put a secret / service-role key here.

# Supabase project (local stack: `npx supabase status` -> API URL + anon key)
VITE_SUPABASE_URL=http://127.0.0.1:56321
# Local: ANON_KEY from `npx supabase status -o env`. Production: Dashboard -> Project Settings -> API -> anon/publishable key
VITE_SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>

# Public site origin, used for redirects (billing success page, auth emails, portal/approval links)
# Local: http://localhost:3010   Production: https://www.contractordocs.app
VITE_SITE_URL=http://localhost:3010

# Kelviq (billing). Product id is public; it is only used for the static-checkout fallback link.
VITE_KELVIQ_ENV=live
VITE_KELVIQ_PRODUCT_ID=45575a06-3bbc-4fe3-9151-ebfc34d19332
# Optional generic customer-portal page used only when the kelviq-checkout function is unreachable
VITE_KELVIQ_PORTAL_URL=

# Support address shown in the app (defaults to support@contractordocs.app)
VITE_SUPPORT_EMAIL=support@contractordocs.app
